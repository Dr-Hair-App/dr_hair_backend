{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dr-hair-backend",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "DAILY_USAGE_QUOTA", "class_name": "DailyUsageQuota" }]
  },
  "migrations": [{ "tag": "daily-usage-quota-v1", "new_sqlite_classes": ["DailyUsageQuota"] }],
  "ratelimits": [
    { "name": "SHIPPING_QUOTE_RATE_LIMIT", "namespace_id": "8173313", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "NODE_ENV": "production",
    "DRHAIR_DEPLOYMENT_ENV": "production",
    "BASE_URL": "https://api.drhairindia.com",
    "CORS_ORIGINS": "https://admin.drhairindia.com",
    "SUPER_ADMIN_ID": "dr.hair@admin",
    "SUPER_ADMIN_NAME": "Dr. Jai Bansal"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "5bc14761-3131-469d-957d-3674564f3e30",
      "database_name": "dr-hair-production",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "dr-hair-production-media"
    }
  ],
  "kv_namespaces": [
    { "binding": "PUBLIC_CONFIG_KV", "id": "ed114227c83c431cb0e7c8e4c4c5c93f" }
  ],
  "routes": [
    { "pattern": "api.drhairindia.com", "custom_domain": true }
  ]
}
