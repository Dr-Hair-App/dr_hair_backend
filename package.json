{
  "name": "dr-hair-backend",
  "version": "1.0.0",
  "description": "Dr. Hair API for Cloudflare Workers with D1 and R2",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "wrangler dev --ip 0.0.0.0",
    "dev": "wrangler dev",
    "admin:setup": "node src/scripts/setup-super-admin.js",
    "test": "node --test test/**/*.test.js",
    "build:cloudflare": "wrangler deploy --dry-run --env=",
    "deploy:cloudflare": "wrangler deploy",
    "deploy": "wrangler deploy --env staging"
  },
  "keywords": [
    "express",
    "clean-architecture",
    "modular-monolith",
    "dr-hair",
    "flutter-backend"
  ],
  "author": "Dr. Hair Engineering Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
