# Server Configuration
PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001

# Security & Authentication
# Required: generate with `openssl rand -base64 32` and paste into your local .env.
JWT_SECRET=
JWT_EXPIRES_IN=30d
CORS_ORIGINS=

# The first Super Admin can authenticate from this private local bootstrap account.
# Generate the scrypt hash with `npm run admin:setup`; never store a plain password here.
SUPER_ADMIN_ID=
SUPER_ADMIN_NAME=Dr. Hair Super Admin
SUPER_ADMIN_PASSWORD_HASH=

# Production must use an external OTP delivery API; development uses the test OTP above.

# Cloudflare local development uses the local D1 database through `wrangler dev`.
# D1/R2/KV bindings are declared in wrangler.jsonc.

# File Upload Configuration (image uploads go to the private Cloudflare R2 bucket)
MAX_FILE_SIZE_MB=25

# Firebase Admin SDK (backend push notifications)
# Add credentials only after creating the Firebase project and service identity.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Use matching Razorpay Test Mode or Live API credentials. Never put the secret in the mobile app.
# Keep the Key Secret and webhook secret only in the backend environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OAuth web client ID from Firebase Project settings. Used to verify Google ID tokens.
GOOGLE_OAUTH_CLIENT_ID=

# Shiprocket's documented external API uses live account data; it does not expose a separate API sandbox.
# Local development leaves shipping disabled. Staging enables a deterministic simulator with
# SHIPROCKET_STAGING_MODE=mock. Only set SHIPROCKET_API_ENV=production when live shipping is intended.
SHIPROCKET_API_ENV=disabled
# Live API user credentials (created under Shiprocket Settings > API Users). Never use in staging.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# A matching pickup location and packed parcel measurements are required.
SHIPROCKET_PICKUP_LOCATION=
# Webhook security token configured in Shiprocket dashboard (x-api-key header)
SHIPROCKET_WEBHOOK_SECRET=
# Optional fallback defaults only; product supply plans now carry package profiles
SHIPROCKET_PACKAGE_LENGTH_CM=
SHIPROCKET_PACKAGE_BREADTH_CM=
SHIPROCKET_PACKAGE_HEIGHT_CM=
SHIPROCKET_PACKAGE_WEIGHT_KG=

# OTP Settings
OTP_EXPIRY_MINUTES=10

# SMS / OTP Gateway Configuration (2Factor.in is primary)
SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# Google Gemini Flash AI (Medical Assistant, Scalp Analysis & Hair Test)
# Get your free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
